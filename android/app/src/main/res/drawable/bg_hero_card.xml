<?xml version="1.0" encoding="utf-8"?>
<!-- Segment 31: the "LIVE SIGNAL" hero card (Branch 2's waveform). Same
     border-layering technique as bg_vitals_card.xml, but tinted with
     accent_branch2 (~30% alpha) instead of the neutral surface_card_border
     — a deliberate, subtle color cue that this is the featured card, not
     just a copy-pasted panel. The fill itself is a two-stop vertical
     gradient (slightly lighter at top) rather than a flat solid, for a
     touch of depth against the camera feed above it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_branch2_border" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/surface_card_top"
                android:endColor="@color/surface_card" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
