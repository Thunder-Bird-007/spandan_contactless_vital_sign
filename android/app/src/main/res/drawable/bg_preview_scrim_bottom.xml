<?xml version="1.0" encoding="utf-8"?>
<!-- Segment 31: a soft gradient fade at the bottom of the camera preview,
     purely cosmetic — eases the visual transition from live video into the
     opaque card stack below instead of the card's top edge cutting across
     the feed abruptly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/preview_scrim_top"
        android:endColor="@color/preview_scrim_bottom" />
</shape>
