<?xml version="1.0" encoding="utf-8"?>
<!--
  Segment 16 Task 3 UI/UX pass. Presentation-only redesign — no change to
  the camera/signal pipeline; see docs/Segment16_Task3_UI_UX_Pass.md for the
  before/after screenshots and rationale. Kept every existing view ID
  (previewView, overlayView, permissionDeniedView, hrText, spo2Text,
  grantPermissionButton, rootLayout) so MainActivity.kt's existing
  findViewById wiring is untouched; new views/IDs are additive.

  What changed vs. the prior plain layout:
    - HR/SpO2 moved into a single rounded "vitals card" (bg_vitals_card.xml)
      instead of a flat black strip, for contrast against a bright camera
      feed and a clearer visual grouping.
    - Each metric now has a small caption ("HEART RATE"/"BLOOD OXYGEN"), a
      larger/bolder value (was 20sp plain white, now 34sp bold), and its own
      colored status pill (dot + short label) driven by
      signal.EstimatorStatus (Segment 16 Task 1/2) plus a UI-only NO_FACE
      case — replacing the old approach of collapsing every non-value case
      into the same generic placeholder text with no explanation.
    - A "No face detected" banner now appears centered over the preview
      (previously: the overlay boxes just silently disappeared with no
      other feedback).

  Segment 31 (see docs/Segment31_UI_UX_Branch2_LiveSignal.md): the old
  raw-green-channel "LIVE SIGNAL" chart (chartView/SignalChartView, id
  removed) is GONE — it was the shared, unfiltered input both branches
  consume, not either branch's own output, and was being read as "Branch
  1's live signal." Branch 2's own waveform view (morphologyWaveformView,
  id unchanged) is now promoted to be the app's ONE primary "LIVE SIGNAL"
  card, in its own tinted "hero" panel (bg_hero_card.xml) directly under the
  camera preview. Also added: a bottom scrim under the preview
  (bg_preview_scrim_bottom.xml) and heart/droplet icons on the vitals card,
  purely cosmetic.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <!-- Draws the live face-box + ROI-box overlay on top of the preview. -->
        <com.spandan.app.ui.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Segment 31: purely cosmetic fade at the bottom of the preview so
             the transition into the opaque card stack below is gradual
             instead of the hero card's top edge cutting across live video. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_preview_scrim_bottom" />

        <!-- Segment 16 Task 3: NEW. Shown/hidden by MainActivity based on
             how long it's been since a face was last detected (a brief gap
             between frames is normal and should NOT flash this banner —
             see MainActivity's own debounce constant). -->
        <LinearLayout
            android:id="@+id/noFaceBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_no_face_banner"
            android:paddingHorizontal="28dp"
            android:paddingVertical="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_face_banner_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/no_face_banner_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:maxWidth="260dp" />
        </LinearLayout>

        <!-- Shown only when camera permission is denied; see MainActivity. -->
        <LinearLayout
            android:id="@+id/permissionDeniedView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#CC000000"
            android:visibility="gone"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:gravity="center"
                android:text="@string/permission_rationale" />

            <Button
                android:id="@+id/grantPermissionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grant_permission" />
        </LinearLayout>

    </FrameLayout>

    <!-- Segment 31: the app's ONE primary "LIVE SIGNAL" card — Branch 2's
         waveform (Segment 19), promoted from a small secondary card into
         the featured panel directly under the camera. Tinted border/
         gradient fill (bg_hero_card.xml) visually distinguishes it as the
         featured card, not just another copy of the vitals card. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hero_card"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/morphology_label"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="8dp"
            android:text="@string/morphology_subtitle"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <!-- One ensemble-averaged cardiac cycle, with the detected notch
             (if any) marked; see ui/WaveformView.kt. Taller than the old
             secondary-card size (90dp) now that this is the hero visual. -->
        <com.spandan.app.ui.WaveformView
            android:id="@+id/morphologyWaveformView"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:id="@+id/morphologyStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_status_dot" />

            <TextView
                android:id="@+id/morphologyStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:text="@string/status_warming_up" />
        </LinearLayout>
    </LinearLayout>

    <!-- Vitals card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_vitals_card"
        android:paddingVertical="18dp">

        <!-- HR metric -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Segment 31: small tinted glyph above the caption, purely
                 cosmetic — gives each metric a distinct visual identity at
                 a glance instead of two identical-looking text columns. -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/accent_hr"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hr_label"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/hrText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="@string/hr_placeholder_default" />

            <!-- Status pill: colored dot + short label, replacing the old
                 always-on-or-always-off "● LIVE" chip with one that reflects
                 EstimatorStatus (Segment 16 Task 1) or NO_FACE. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/hrStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_status_dot" />

                <TextView
                    android:id="@+id/hrStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:text="@string/status_warming_up" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hairline vertical divider between the two metrics. -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="4dp"
            android:background="@color/surface_card_border" />

        <!-- SpO2 metric -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_droplet"
                app:tint="@color/accent_spo2"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/spo2_label"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/spo2Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="@string/spo2_placeholder_default" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/spo2StatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_status_dot" />

                <TextView
                    android:id="@+id/spo2StatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:text="@string/status_warming_up" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
