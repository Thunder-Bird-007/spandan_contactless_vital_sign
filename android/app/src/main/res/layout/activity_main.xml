<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-screen layout: camera preview + overlays on top, live raw-signal
  chart, then the HR readout. SpO2 has no UI here at all: not hidden, not a
  placeholder number, removed outright, because no validated SpO2
  calibration exists to ship (see
  ../../../../../../matlab/docs/SpO2_Final_Report_Section.md). hrStatusText
  carries a "SpO2 omitted" note alongside the "real pipeline" chip instead of
  a separate SpO2 column, since there's no SpO2 value to attach a chip to
  anymore. Deliberately simple: functional skeleton, not defense-day polish.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <!-- Draws the live face-box + ROI-box overlay on top of the preview. -->
        <com.spandan.app.ui.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shown only when camera permission is denied; see MainActivity. -->
        <LinearLayout
            android:id="@+id/permissionDeniedView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#CC000000"
            android:visibility="gone"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:text="@string/permission_rationale" />

            <Button
                android:id="@+id/grantPermissionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grant_permission" />
        </LinearLayout>

    </FrameLayout>

    <!-- Live scrolling raw green-channel signal: genuinely useful even
         before real filtering exists (see ui/SignalChartView.kt). -->
    <com.spandan.app.ui.SignalChartView
        android:id="@+id/chartView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <TextView
            android:id="@+id/hrText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:text="@string/hr_placeholder_default" />

        <TextView
            android:id="@+id/hrStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:text="@string/hr_status_real" />

        <TextView
            android:id="@+id/spo2OmittedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:gravity="center"
            android:text="@string/spo2_omitted_note" />
    </LinearLayout>

</LinearLayout>
