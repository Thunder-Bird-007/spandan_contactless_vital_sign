<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Spandan</string>

    <string name="permission_rationale">Camera access is needed to capture your face for heart-rate and SpO2 estimation. No video is stored or sent anywhere.</string>
    <string name="grant_permission">Grant camera permission</string>

    <!-- HR is a real CHROM/POS+FFT pipeline, see signal/RealHeartRateEstimator.kt.
         The old per-field "● LIVE — CHROM/POS + FFT" status chip string
         (hr_status_real) was removed along with its TextView in
         activity_main.xml for a cleaner UI; see that layout's own top
         comment. -->
    <string name="hr_format">HR: %.0f bpm</string>
    <string name="hr_placeholder_default">HR: -- bpm</string>

    <!-- SpO2 is a real computation (signal/LiveSpo2Estimator.kt: ratio-of-ratios
         + the uncentered production linear calibration from
         matlab/docs/SpO2_Final_Calibration_Spec.md), unlike the old fake-sine
         placeholder.

         2 decimal places, not 1: on-device verification showed the real,
         live-tracking span (96.72-96.94% observed) is narrow enough at 1dp
         that consecutive ticks can round to the same displayed number, making
         a genuinely live value look static during a demo. The extra digit is
         a DISPLAY-VISIBILITY fix only: it does not claim any measurement
         precision beyond what LiveSpo2Estimator.kt actually computes (see
         that file's own KDoc/docs/SpO2_Live_Implementation.md for the real
         accuracy caveats); the underlying formula/clamp are unchanged.

         The old per-field "Estimate — validated against a narrow reference
         range (87-99%)" subtitle string (spo2_subtitle) was removed along
         with its TextView in activity_main.xml for a cleaner UI; same
         caveats still documented in LiveSpo2Estimator.kt's KDoc and
         docs/SpO2_Live_Implementation.md, just not shown on-screen anymore. -->
    <string name="spo2_format">SpO2: %.2f%%</string>
    <string name="spo2_placeholder_default">SpO2: -- %</string>
</resources>
